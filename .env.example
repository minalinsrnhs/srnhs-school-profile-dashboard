# Local test mode: no external database needed.
DATA_BACKEND=sqlite
FLASK_SECRET_KEY=replace-with-a-long-random-private-string
SESSION_COOKIE_SECURE=0
MAX_UPLOAD_MB=25

# First account. For local initial testing, these seed a fresh local database.
FIRST_ACCOUNT_NAME=SRNHS Admin
FIRST_ACCOUNT_USERNAME=admin
FIRST_ACCOUNT_PASSWORD=replace-with-a-new-private-password

# Online deployment mode: set DATA_BACKEND=supabase and enter these in the
# hosting platform environment-variable settings, never in GitHub.
# DATA_BACKEND=supabase
# SUPABASE_URL=https://YOUR_PROJECT_REFERENCE.supabase.co
# SUPABASE_SECRET_KEY=YOUR_BACKEND_ONLY_SECRET_KEY
# Legacy fallback also supported: SUPABASE_SERVICE_ROLE_KEY=YOUR_BACKEND_ONLY_LEGACY_SERVICE_ROLE_KEY
# SESSION_COOKIE_SECURE=1
